# Salin file ini jadi ".env" lalu isi sendiri. File .env tidak ikut ke git.

# Token bot dari @BotFather
TG_BOT_TOKEN=
# ID channel kotak masuk (angka negatif, -100...) dan ID akun Telegram kamu.
# Cara cari: MENU.bat > Utilitas > Cari ID Telegram
TG_INBOX_CHANNEL_ID=
TG_ADMIN_USER_ID=

# Boleh dikosongkan kalau MT5 desktop sudah dibuka dan login sendiri (disarankan).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# --- Pembaca sinyal (program kedua) ---
# API ID dan API hash dari https://my.telegram.org (login pakai akun Telegram-mu,
# menu "API development tools"). Ini akses ke akunmu: jangan dibagikan ke siapa pun.
TG_API_ID=
TG_API_HASH=
# Mata pembaca = Claude Code (ikut langganan Pro). Tidak perlu key di sini:
# cukup login sekali di terminal dengan perintah:  claude auth login
