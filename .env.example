# Salin file ini jadi ".env" lalu isi sendiri. File .env tidak ikut ke git.

# Token bot dari @BotFather
TG_BOT_TOKEN=
# ID channel kotak masuk (angka negatif, -100...) dan ID akun Telegram kamu.
# Cara cari: python -m copier.main --cari-id
TG_INBOX_CHANNEL_ID=
TG_ADMIN_USER_ID=

# Boleh dikosongkan kalau MT5 desktop sudah dibuka dan login sendiri (disarankan).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
